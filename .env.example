# AddisPulse placeholders only. Never commit real credentials.

# -----------------------------------------------------------------------------
# Browser-safe
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-staging-anonymous-key

# -----------------------------------------------------------------------------
# Server-only
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-local-or-staging-service-role-key
OTP_PROVIDER=africas_talking
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=your-africas-talking-username
AT_SENDER_ID=AddisPulse
IP_HASH_SECRET=replace-with-at-least-32-random-characters
DEVICE_FP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_WORKER_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=AddisPulse <notifications@example.com>
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Local-development and automated-test only
# Never configure fake_local in a production environment.
# -----------------------------------------------------------------------------
# OTP_PROVIDER=fake_local
OTP_FAKE_CODE=123456
OTP_FAKE_FAIL=false

# -----------------------------------------------------------------------------
# Staging-validation only
# These are consumed by scripts/staging and must never target production.
# Copy these entries to .env.local and replace placeholders there.
# Keep ALLOW_STAGING_FIXTURES=false until intentionally running guarded fixtures.
# -----------------------------------------------------------------------------
ALLOW_STAGING_FIXTURES=false
STAGING_PROJECT_REF=gfunjmvwfkrnkbstffco
STAGING_SUPABASE_URL=https://gfunjmvwfkrnkbstffco.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
PRODUCTION_PROJECT_REF=your-distinct-production-project-ref
STAGING_APP_URL=https://your-approved-staging-or-vercel-preview-url
