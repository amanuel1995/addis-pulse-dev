# =============================================================================
# AddisPulse Media — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (get from your Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_your_key
EMAIL_FROM=AddisPulse Leads <leads@addispulse.com>

# Telegram — Ops lead alert bot (notifies fixed receiver of new leads)
TELEGRAM_OPS_BOT_TOKEN=your-ops-bot-token
DEFAULT_OPS_TELEGRAM_CHAT_ID=your-chat-id

# Telegram — Driver operations bot (driver check-in, inventory, score)
TELEGRAM_DRIVER_BOT_TOKEN=your-driver-bot-token

# SMS / OTP — Africa's Talking (https://africastalking.com)
OTP_PROVIDER=fake
OTP_FAKE_FAIL=false
OTP_FAKE_CODE=123456
AT_API_KEY=your-at-api-key
AT_USERNAME=your-at-username
AT_SENDER_ID=AddisPulse

# Security — generate random secrets: openssl rand -hex 32
IP_HASH_SECRET=change-me-to-random-hex-32
DEVICE_FP_HASH_SECRET=change-me-to-random-hex-32
OTP_SECRET=change-me-to-random-hex-32
RATE_LIMIT_SECRET=change-me-to-random-hex-32

# Feature config
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
CSV_EXPORT_MAX_ROWS=50000
FRAUD_VELOCITY_THRESHOLD=3
